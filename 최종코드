import matplotlib.pyplot as plt
import pandas as pd
import streamlit as st
from io import StringIO

# 한글 설정
plt.rcParams["font.family"] = "Malgun Gothic"
plt.rcParams["axes.unicode_minus"] = False

# 페이지 레이아웃 확장 (좌우 비교를 위해 wide 모드 설정)
st.set_page_config(layout="wide")


# =========================
# 도서관 CSV 읽기
# =========================
def load_library_csv(file):
    encodings = ["utf-8", "cp949", "euc-kr"]
    for encoding in encodings:
        try:
            file.seek(0)
            raw_text = file.read().decode(encoding)
            # 파일명에서 지역구분 키워드 추출 (예: 서울.csv -> 서울)
            region_hint = file.name.split(".")[0]

            df = pd.read_csv(StringIO(raw_text), skiprows=2)
            return raw_text, df, region_hint
        except:
            continue
    return None, None, None


# =========================
# 인구구조 CSV 읽기
# =========================
def load_population_csv(file):
    encodings = ["utf-8", "cp949", "euc-kr"]
    for encoding in encodings:
        try:
            file.seek(0)
            raw_text = file.read().decode(encoding)
            df = pd.read_csv(StringIO(raw_text))
            return raw_text, df
        except:
            continue
    return None, None


# =========================
# 도서관 전처리
# =========================
def preprocess_library(df, file_name_hint):
    df.columns = [
        "도서관",
        "지역",
        "인쇄_어린이",
        "인쇄_청소년",
        "인쇄_성인",
        "인쇄_합계",
        "전자_어린이",
        "전자_청소년",
        "전자_성인",
        "전자_합계",
    ]

    numeric_cols = [
        "인쇄_어린이",
        "인쇄_청소년",
        "인쇄_성인",
        "인쇄_합계",
        "전자_어린이",
        "전자_청소년",
        "전자_성인",
        "전자_합계",
    ]

    for col in numeric_cols:
        df[col] = df[col].astype(str).str.replace(",", "", regex=False)
        df[col] = pd.to_numeric(df[col], errors="coerce")

    df = df.dropna().copy()

    # 데이터 내 '지역' 컬럼이 비어있거나 불분명할 경우 파일 이름 힌트로 마스킹 보완
    for keyword in ["서울", "부산", "경기", "세종", "강원", "전남"]:
        if keyword in file_name_hint:
            df["지역"] = keyword
            break

    return df


# =========================
# 인구구조 전처리
# =========================
def preprocess_population(df):
    df = df.iloc[:, 1:4]
    df.columns = ["지역", "구분", "비율"]
    df["비율"] = pd.to_numeric(df["비율"], errors="coerce")

    result = []
    for region in df["지역"].unique():
        temp = df[df["지역"] == region]
        values = temp["비율"].tolist()
        if len(values) >= 3:
            result.append([region, values[0], values[1], values[2]])

    pop_df = pd.DataFrame(result, columns=["지역", "유소년", "생산연령", "노년"])
    pop_df["지역"] = pop_df["지역"].replace(
        {
            "서울특별시": "서울",
            "부산광역시": "부산",
            "경기도": "경기",
            "세종특별자치시": "세종",
            "강원특별자치도": "강원",
            "전라남도": "전남",
        }
    )
    return pop_df


# =========================
# 도서관 그래프
# =========================
def library_graph(df):
    st.subheader("연령별 이용 현황")
    print_data = [
        df["인쇄_어린이"].sum(),
        df["인쇄_청소년"].sum(),
        df["인쇄_성인"].sum(),
    ]
    elec_data = [
        df["전자_어린이"].sum(),
        df["전자_청소년"].sum(),
        df["전자_성인"].sum(),
    ]
    labels = ["어린이", "청소년", "성인"]

    fig, ax = plt.subplots(figsize=(8, 5))
    x = range(len(labels))

    ax.bar([i - 0.2 for i in x], print_data, width=0.4, label="인쇄자료")
    ax.bar([i + 0.2 for i in x], elec_data, width=0.4, label="전자자료")

    ax.set_xticks(list(x))
    ax.set_xticklabels(labels)
    ax.legend()
    st.pyplot(fig)


# =========================
# 인구구조 그래프
# =========================
def population_graph(df):
    st.subheader("지역별 인구구조")
    fig, ax = plt.subplots(figsize=(10, 6))
    df.set_index("지역")[["유소년", "생산연령", "노년"]].plot(
        kind="bar", stacked=True, ax=ax
    )
    st.pyplot(fig)


# =========================
# 통합 분석
# =========================
def merged_graph(df):
    st.subheader("지역별 도서관 이용량")
    fig, ax = plt.subplots(figsize=(10, 6))
    ax.bar(df["지역"], df["인쇄_합계"])
    ax.set_title("지역별 인쇄자료 이용량")
    plt.xticks(rotation=45)
    st.pyplot(fig)


# =========================
# 상관관계 분석
# =========================
def correlation_graph(df):
    st.subheader("유소년 비율과 어린이 이용량")
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.scatter(df["유소년"], df["인쇄_어린이"])

    for i in range(len(df)):
        ax.text(
            df["유소년"].iloc[i],
            df["인쇄_어린이"].iloc[i],
            df["지역"].iloc[i],
        )

    ax.set_xlabel("유소년 비율")
    ax.set_ylabel("어린이 이용량")
    st.pyplot(fig)


# =========================
# [수정] 좌우 비교 그래프 함수 (seaborn 제거 버전)
# =========================
def compare_dashboard_graph(merged_df):
    col1, col2 = st.columns(2)

    # 1. 왼쪽: 인구구조 누적 막대그래프
    with col1:
        st.write("#### 🔹 [원인 분석] 지역별 인구구조 비율")
        fig1, ax1 = plt.subplots(figsize=(6, 5))
        merged_df.set_index("지역")[["유소년", "생산연령", "노년"]].plot(
            kind="bar",
            stacked=True,
            color=["#4f79a7", "#f28e2b", "#59a14f"],
            ax=ax1,
        )
        ax1.set_ylabel("비율 (%)")
        plt.xticks(rotation=0)
        st.pyplot(fig1)

    # 2. 오른쪽: 연령구분별 멀티 막대그래프 (matplotlib 전용 구현)
    with col2:
        st.write("#### 🔸 [결과 확인] 지역별 연령대 인쇄자료 이용 건수")
        fig2, ax2 = plt.subplots(figsize=(6, 5))

        # 인덱스 기준으로 x축 위치 설정
        df_sorted = merged_df.set_index("지역")
        regions = df_sorted.index
        x = range(len(regions))
        width = 0.25

        # 순수 matplotlib 바 플롯으로 그룹 막대그래프 구현
        ax2.bar(
            [i - width for i in x],
            df_sorted["인쇄_어린이"],
            width=width,
            label="어린이",
            color="#1f77b4",
        )
        ax2.bar(
            [i for i in x],
            df_sorted["인쇄_청소년"],
            width=width,
            label="청소년",
            color="#ff7f0e",
        )
        ax2.bar(
            [i + width for i in x],
            df_sorted["인쇄_성인"],
            width=width,
            label="성인",
            color="#2ca02c",
        )

        ax2.set_ylabel("이용 건수")
        ax2.set_xticks(list(x))
        ax2.set_xticklabels(regions)
        ax2.legend(title="연령구분")
        plt.xticks(rotation=0)
        st.pyplot(fig2)


# =========================
# 메인
# =========================
def main():
    st.title("📊 지역별 공공도서관 이용현황 및 인구구조 다차원 분석")

    tab1, tab2, tab3, tab4, tab5 = st.tabs(
        [
            "도서관 분석",
            "인구구조 분석",
            "통합 분석",
            "상관관계 분석",
            "⚖️ 인구구조 vs 도서관 비교 분석",
        ]
    )

    with st.sidebar:
        st.header("파일 통합 업로드")

        # accept_multiple_files=True 옵션으로 여러 도서관 CSV 파일 일괄 수집
        library_files = st.file_uploader(
            "도서관 CSV 파일들 (다중 선택 가능)", type="csv", accept_multiple_files=True
        )

        st.write(f"업로드된 도서관 파일 수: {len(library_files)}개")

        st.markdown("---")
        st.header("인구구조 데이터")
        population = st.file_uploader("인구구조 CSV", type="csv")

    library_list = []
    if library_files:
        for file in library_files:
            _, df, region_hint = load_library_csv(file)
            if df is not None:
                df = preprocess_library(df, region_hint)
                library_list.append(df)

    if len(library_list) > 0:
        library_df = pd.concat(library_list, ignore_index=True)
    else:
        library_df = None

    population_df = None
    if population:
        _, population_df = load_population_csv(population)
        population_df = preprocess_population(population_df)

    # 탭 구현
    with tab1:
        if library_df is not None:
            st.dataframe(library_df)
            library_graph(library_df)
        else:
            st.warning("사이드바에 도서관 CSV 파일들을 업로드해 주세요.")

    with tab2:
        if population_df is not None:
            st.dataframe(population_df)
            population_graph(population_df)
        else:
            st.warning("사이드바에 인구구조 CSV 파일을 업로드해 주세요.")

    with tab3:
        if library_df is not None and population_df is not None:
            region_df = (
                library_df.groupby("지역")
                .sum(numeric_only=True)
                .reset_index()
            )
            merged = pd.merge(region_df, population_df, on="지역")
            st.dataframe(merged)
            merged_graph(merged)
        else:
            st.warning(
                "도서관 파일들과 인구구조 파일이 모두 업로드되어야 결합 데이터를 볼 수 있습니다."
            )

    with tab4:
        if library_df is not None and population_df is not None:
            region_df = (
                library_df.groupby("지역")
                .sum(numeric_only=True)
                .reset_index()
            )
            merged = pd.merge(region_df, population_df, on="지역")
            correlation_graph(merged)
        else:
            st.warning("데이터 업로드가 필요합니다.")

    # 5번째 비교 분석 탭
    with tab5:
        st.subheader("⚖️ 인구구조 원인과 인쇄자료 소비 결과 대조")
        if library_df is not None and population_df is not None:
            region_df = (
                library_df.groupby("지역")
                .sum(numeric_only=True)
                .reset_index()
            )
            merged = pd.merge(region_df, population_df, on="지역")

            # 좌우 나란히 배치하는 함수 호출
            compare_dashboard_graph(merged)

            st.markdown("---")
            st.markdown("### 💡 대시보드 시각 자료 해석 및 비교 인사이트")
            st.info(
                "**1. 수도권(경기·서울)의 집중 현상:** 생산인구 비율(71.8%)이 두터운 만큼 성인층의 인쇄 자료 소비 활동이 거대한 기둥 그래프 형태로 시각화됩니다.\n\n"
                "**2. 고령화 지표가 만든 소비 임계점:** 강원, 전남, 부산의 경우 인구 비율 그래프에서 녹색(노년)층 비중이 매우 큰 반면 파란색(유소년)이 극도로 좁아, 오른쪽 그래프에서 어린이/청소년 인쇄 이용량이 바닥을 치는 원인 관계를 직접 확인할 수 있습니다.\n\n"
                "**3. 세종시의 구조적 특징:** 전체 인구가 적어 막대 높이 자체는 낮지만, 유소년 비율(17.2%)이 독보적으로 높기 때문에 오른쪽 이용량 그래프에서 어린이 이용 비중이 균형감 있게 방어되고 있습니다."
            )
        else:
            st.warning(
                "도서관 파일들과 인구구조 파일이 모두 업로드되어야 교차 비교 대시보드가 활성화됩니다."
            )


if __name__ == "__main__":
    main()
